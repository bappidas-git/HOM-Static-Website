# H.O.M Advisory — Environment Variables
# Copy this file to .env.local and update the values

# API Base URL
# For development with JSON Server:
REACT_APP_API_URL=http://localhost:3001
# For production with Laravel backend:
# REACT_APP_API_URL=https://api.homadvisory.com/api/v1

# Site Configuration
REACT_APP_SITE_NAME=H.O.M Advisory

# Google Maps API Key (for property location maps)
REACT_APP_GOOGLE_MAPS_KEY=your_key_here
